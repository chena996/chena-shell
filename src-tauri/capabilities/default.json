{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window and the SFTP/editor child windows. Window creation stays in the Rust backend, so the create permissions are intentionally absent.",
  "windows": ["main", "chena-sftp-*", "chena-edit-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-decorations",
    "core:window:allow-center",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-inner-size",
    "core:window:allow-inner-position",
    "core:window:allow-is-minimized",
    "core:window:allow-is-maximized",
    "core:window:allow-is-decorated",
    "core:window:allow-is-visible",
    "core:window:allow-is-focused",
    "core:window:allow-get-all-windows",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:webview:allow-set-webview-focus"
  ]
}
